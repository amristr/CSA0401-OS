PROGRAM:

#include <stdio.h>
#include <stdlib.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/types.h>
#include <sys/stat.h>
#include <dirent.h>
#include <errno.h>

int main()
{
    int fd;
    struct stat fileStat;
    DIR *dir;
    struct dirent *entry;

    fd = open("foo.txt", O_RDONLY | O_CREAT, 0644);

    printf("File descriptor = %d\n", fd);

    if (fd == -1)
    {
        printf("Error Number: %d\n", errno);
        perror("Program");
        return 1;
    }

    printf("File opened successfully.\n");

    lseek(fd, 0, SEEK_SET);
    printf("File position set using lseek().\n");

    if (stat("foo.txt", &fileStat) == 0)
    {
        printf("File size: %ld bytes\n", fileStat.st_size);
    }

    dir = opendir(".");

    if (dir == NULL)
    {
        perror("opendir");
        close(fd);
        return 1;
    }

    printf("Directory contents:\n");

    while ((entry = readdir(dir)) != NULL)
    {
        printf("%s\n", entry->d_name);
    }

    closedir(dir);
    close(fd);

    return 0;
}


