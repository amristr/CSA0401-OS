#include <stdio.h>
#include <dirent.h>

int main()
{
    struct dirent *entry;
    DIR *dir;

    dir = opendir(".");

    if (dir == NULL)
    {
        printf("Unable to open directory.\n");
        return 1;
    }

    printf("Files and Directories:\n");

    while ((entry = readdir(dir)) != NULL)
    {
        printf("%s\n", entry->d_name);
    }

    closedir(dir);

    return 0;
}


